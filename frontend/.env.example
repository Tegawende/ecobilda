# API Configuration
VITE_API_BASE_URL=http://localhost:8000/api

# Mapbox Configuration
VITE_MAPBOX_ACCESS_TOKEN=your_mapbox_token_here

# OAuth Configuration
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
